# `python3 -m py_compile` writes these next to the script, and
# `injection-write-discipline.test.ts` compiles the injection batteries to
# check their syntax. Build output does not belong in the tree.
__pycache__/
*.pyc

# The gate-test battery's own run report. It is written on every run, including
# the failing ones, and uploaded as a CI artifact -- it is output, not source,
# and a committed copy would be one run's verdicts read as if they were the
# current ones.
gate-tests-battery-report.json
