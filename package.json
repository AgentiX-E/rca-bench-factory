{
  "name": "rca-bench-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Turn non-standard enterprise telemetry into authoritative RCA benchmark field contracts.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @rca-bench-factory/core build && pnpm --filter @rca-bench-factory/cli build",
    "typecheck": "pnpm --filter @rca-bench-factory/core typecheck && pnpm --filter @rca-bench-factory/cli typecheck",
    "test": "pnpm --filter @rca-bench-factory/core test && pnpm --filter @rca-bench-factory/cli test",
    "test:coverage": "pnpm --filter @rca-bench-factory/core test:coverage && pnpm --filter @rca-bench-factory/cli test:coverage",
    "lint": "node scripts/check-no-mock.mjs && node scripts/check-no-secrets.mjs",
    "examples:gen": "node scripts/gen-examples.mjs",
    "examples:check": "node scripts/gen-examples.mjs --check",
    "examples:bundle": "node scripts/build-example-bundle.mjs",
    "examples:bundle:check": "node scripts/build-example-bundle.mjs --check",
    "official:check": "node scripts/check-official.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "docs:check": "node scripts/check-readme-sample.mjs && node scripts/check-cli-reference.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
