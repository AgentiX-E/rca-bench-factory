# rca-bench-factory — environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real credentials. The `check-no-secrets` lint guard fails CI on any
# credential-shaped literal in tracked files.

# ---- LLM provider (for assisted rule generation) ----------------------------
# Provider-agnostic: any OpenAI-compatible chat endpoint works.
# Examples: DeepSeek, Zhipu GLM, or a self-hosted vLLM/ollama gateway.
RCA_BENCH_LLM_BASE_URL=https://api.deepseek.com/v1
RCA_BENCH_LLM_MODEL=deepseek-chat
RCA_BENCH_LLM_API_KEY=
# Optional: temperature for rule generation (default 0).
RCA_BENCH_LLM_TEMPERATURE=0

# ---- Observability source credentials (optional, per adapter) ---------------
# Prometheus-compatible API
RCA_BENCH_PROM_URL=
RCA_BENCH_PROM_TOKEN=

# ---- Golden Master / verification ------------------------------------------
# Base URL hosting official benchmark archives for fetch-and-verify (defaults to
# the official repositories listed in THIRD-PARTY-NOTICES.md).
RCA_BENCH_OFFICIAL_BASE_URL=
