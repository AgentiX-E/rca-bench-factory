# rca-bench-factory — environment template
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real credentials. The `check-no-secrets` lint guard fails CI on any
# credential-shaped literal in tracked files.

# ---- LLM provider (for assisted rule generation) ----------------------------
# Provider-agnostic: any OpenAI-compatible chat endpoint works.
# Examples: DeepSeek, OpenAI, Zhipu GLM, or a self-hosted vLLM/ollama gateway.
RCA_BENCH_LLM_BASE_URL=https://api.deepseek.com/v1
RCA_BENCH_LLM_MODEL=deepseek-chat
RCA_BENCH_LLM_API_KEY=
# Optional: temperature for rule generation (default 0).
RCA_BENCH_LLM_TEMPERATURE=0
# Anthropic uses the Messages API (not OpenAI-compatible): set these instead when
# selecting the Anthropic adapter.
RCA_BENCH_ANTHROPIC_BASE_URL=https://api.anthropic.com
RCA_BENCH_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
RCA_BENCH_ANTHROPIC_API_KEY=
RCA_BENCH_ANTHROPIC_MAX_TOKENS=4096

# ---- Observability source credentials (optional, per adapter) ---------------
# Prometheus-compatible API
RCA_BENCH_PROM_URL=
RCA_BENCH_PROM_TOKEN=

# ---- Golden Master / verification ------------------------------------------
# Nothing to configure. Upstream corpora are fetched at check time from the
# canonical URLs in golden-master/official-assets.json, which also records the
# licence for each one. `scripts/fetch-official.mjs --list` prints the registry.
#
# There is deliberately no base-URL override here. An earlier revision of this
# file offered `RCA_BENCH_OFFICIAL_BASE_URL`, which no code ever read: the asset
# registry is the single source of truth for where data comes from, and a second,
# unchecked way to redirect a fetch is a supply-chain hole rather than a
# convenience. The other half of the rule -- data goes to a path outside the
# working tree -- is enforced by fetch-official.mjs and check-no-vendored-data.mjs.
