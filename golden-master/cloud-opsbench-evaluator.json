  "differences": [
    {
      "case": "empty-key-empty-prediction",
      "upstream": 1.0,
      "here": 0.0,
      "why": "The evaluator compares two normalised strings, and two empty strings are equal, so a key that declares nothing awards a point for an answer that says nothing. Here a facet the key does not declare is not scored at all, and a case with nothing scored is 0. Reproducing the free point would make an export of empty keys score a perfect JRA."
    },
    {
      "case": "numeric-component",
      "upstream": 1.0,
      "here": 0.0,
      "why": "The evaluator stringifies with str(value), so the number 8080 matches the component '8080'. This repository's export contract types the component as a string, and a number reads as absent. The difference is in the reader rather than in the rule: a submission that stringifies its own component scores identically under both."
    }
  ]
