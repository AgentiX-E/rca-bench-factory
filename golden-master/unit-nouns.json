  "judgements": [
    {
      "noun": "addendum(s)",
      "populations": [
        [
          "check-open-list",
          "check-progress-volumes"
        ]
      ],
      "relation": "one set of headings read twice -- both walk the volumes and count the `## vX.YY, addendum` sections, `check-open-list` with its own pattern and `check-progress-volumes` through `labelOf` and `populationsOf`, so the two numbers are two readers of one population rather than one reader quoted twice"
    },
    {
      "noun": "budget(s)",
      "silence": "printed only by a round that widened a bound since the reading it compares with, so a tree that widened none has no such number to print -- the word counts the budgets a reading has outgrown, which a round where nothing moved cannot have"
    },
    {
      "noun": "comment(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "two disjoint corpora -- the comments of the sources and the comments of the workflows -- with no member in common and the smaller a small fraction of the larger, which the two counts above state and this sentence no longer copies"
    },
    {
      "noun": "file(s)",
      "populations": [
        [
          "check-citations"
        ],
        [
          "check-comments-language",
          "check-doc-counts"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "four walks over four corpora -- the documentation files `check-citations` anchors its findings in, the source walk's (printed by two gates because one takes its denominator from the other), and the workflow files. The counts are the numbers above and this sentence copies none of them: it used to name the documentation corpus, and a volume of progress is a documentation file, so that figure moved the first time a round opened a volume"
    },
    {
      "noun": "pair(s)",
      "populations": [
        [
          "check-ci-budget"
        ],
        [
          "check-fault-cases"
        ]
      ],
      "relation": "two unrelated kinds of pair -- two readings of one tree, which is the noise floor `O-114` measures and of which this history holds the only one, and every pair of the fault cases `check-fault-cases` compares for overlap; the two numbers are the corpora rather than one count two gates share"
    },
    {
      "noun": "reading(s)",
      "populations": [
        [
          "check-ci-budget"
        ],
        [
          "check-fault-cases"
        ]
      ],
      "relation": "two unrelated kinds of reading -- a step's measured seconds in `check-ci-budget` and a checkpoint's declaration in `check-fault-cases`"
    },
    {
      "noun": "round(s)",
      "populations": [
        [
          "check-open-list",
          "check-progress-volumes"
        ],
        [
          "check-acceptance-shape"
        ]
      ],
      "separate": [
        {
          "gate": "check-ci-budget",
          "counts": "how far the ledger's newest row sits from the newest round -- a distance, so its number is compared with nothing and moves every round the log does not close"
        }
      ],
      "relation": "one set of headings read twice, and a third set of its own -- `check-open-list` counts the distinct `vX.YY` labels among the headings and `check-progress-volumes` counts the sections that carry one, so that the two agree is a rule rather than a coincidence, because no round may be headed twice, and the second gate prints the `Pass` rounds it also counts beside them; `check-acceptance-shape` counts a set of its own -- the distinct rounds the headings of `docs/acceptance.md` name -- and a clause is filed under the round that decided it while one round may decide several, so those rounds are counted once each and the number is compared with nothing outside that page"
    },
    {
      "noun": "row break(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-docs-language"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "one noun over three disjoint corpora -- the sources, the documentation and the workflows -- so no row break is counted by two of them"
    },
    {
      "noun": "row(s)",
      "populations": [
        [
          "check-fault-cases"
        ],
        [
          "check-l4-status"
        ],
        [
          "check-open-list"
        ],
        [
          "check-repository-table"
        ]
      ],
      "relation": "four tables and one word -- a fault case's pre-injection window, the L4 registry, the record tables of the log, and the rows under `## Repository`; that `8` appears twice is the corpus rather than a count two gates share"
    },
    {
      "noun": "run(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-docs-language"
        ],
        [
          "check-fault-cases"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "three language gates count runs of prose in the wrong script and print `0`, and `check-fault-cases` counts baseline runs; the noun is shared and nothing else is"
    },
    {
      "noun": "volume(s)",
      "populations": [
        [
          "check-audit-volumes"
        ],
        [
          "check-progress-volumes"
        ]
      ],
      "relation": "two disjoint directories of volumes -- `docs/audit` and `docs/progress` -- and no file is in both. The counts are the numbers above and this sentence copies none of them: it used to state both, and the second moved the round that opened one more progress volume"
    }
  ]
