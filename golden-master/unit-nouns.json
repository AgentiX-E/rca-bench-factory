  "judgements": [
    {
      "noun": "addendum(s)",
      "populations": [
        [
          "check-open-list",
          "check-progress-volumes"
        ]
      ],
      "relation": "one set of headings read twice -- both walk the volumes and count the `## vX.YY, addendum` sections, `check-open-list` with its own pattern and `check-progress-volumes` through `labelOf` and `populationsOf`, so the two numbers are two readers of one population rather than one reader quoted twice"
    },
    {
      "noun": "comment(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "two disjoint corpora -- the comments of the sources and the comments of the workflows -- with no member in common and the smaller a small fraction of the larger, which the two counts above state and this sentence no longer copies"
    },
    {
      "noun": "file(s)",
      "populations": [
        [
          "check-citations"
        ],
        [
          "check-comments-language",
          "check-doc-counts"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "four walks over four corpora -- the 38 documentation files `check-citations` anchors its findings in, the source walk's 479 (printed by two gates because one takes its denominator from the other), and the 6 workflow files"
    },
    {
      "noun": "reading(s)",
      "populations": [
        [
          "check-ci-budget"
        ],
        [
          "check-fault-cases"
        ]
      ],
      "relation": "two unrelated kinds of reading -- a step's measured seconds in `check-ci-budget` and a checkpoint's declaration in `check-fault-cases`"
    },
    {
      "noun": "round(s)",
      "populations": [
        [
          "check-open-list",
          "check-progress-volumes"
        ],
        [
          "check-ci-budget"
        ],
        [
          "check-acceptance-shape"
        ]
      ],
      "relation": "one set of headings read twice -- `check-open-list` counts the distinct `vX.YY` labels among them and `check-progress-volumes` counts the sections that carry one, so that the two agree is a rule rather than a coincidence, because no round may be headed twice; the second gate prints the `Pass` rounds it also counts beside them; and `check-ci-budget` prints a third thing with the same word -- how many rounds sit between the ledger's newest row and the newest round -- which is a distance and not a count of anything, so its number is compared with nothing and moves every round the log does not close; and `check-acceptance-shape` prints a fourth thing with the same word -- how many distinct rounds the headings of `docs/acceptance.md` name, which is a set of its own: a clause is filed under the round that decided it and one round may decide several clauses, so the rounds the clauses name are counted once each and the number is compared with nothing outside that page"
    },
    {
      "noun": "row break(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-docs-language"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "one noun over three disjoint corpora -- the sources, the documentation and the workflows -- so no row break is counted by two of them"
    },
    {
      "noun": "row(s)",
      "populations": [
        [
          "check-fault-cases"
        ],
        [
          "check-l4-status"
        ],
        [
          "check-open-list"
        ],
        [
          "check-repository-table"
        ]
      ],
      "relation": "four tables and one word -- a fault case's pre-injection window, the L4 registry, the record tables of the log, and the rows under `## Repository`; that `8` appears twice is the corpus rather than a count two gates share"
    },
    {
      "noun": "run(s)",
      "populations": [
        [
          "check-comments-language"
        ],
        [
          "check-docs-language"
        ],
        [
          "check-fault-cases"
        ],
        [
          "check-workflow-language"
        ]
      ],
      "relation": "three language gates count runs of prose in the wrong script and print `0`, and `check-fault-cases` counts baseline runs; the noun is shared and nothing else is"
    },
    {
      "noun": "volume(s)",
      "populations": [
        [
          "check-audit-volumes"
        ],
        [
          "check-progress-volumes"
        ]
      ],
      "relation": "two disjoint directories of volumes -- `docs/audit` holds 14 and `docs/progress` 19, and no file is in both"
    }
  ]
}
